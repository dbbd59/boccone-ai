# ──────────────────────────────────────────────────────────────────────────────
# Boccone AI — root environment (loaded by apps/api and packages/db tooling)
# Copy to .env and adjust. NEVER commit the real .env file.
# ──────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# Matches docker-compose.yml (host port 5433).
DATABASE_URL=postgres://boccone:boccone@localhost:5433/boccone

# ── API ───────────────────────────────────────────────────────────────────────
API_PORT=3000
LOG_LEVEL=info
# Comma-separated list of origins allowed to call the API with credentials.
# Local dev: admin app + Expo web. Native deep links (boccone://) are configured
# in code and must never be listed here.
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:8081

# ── Better Auth ───────────────────────────────────────────────────────────────
# Generate a strong secret: bunx @better-auth/cli generate --secret (or openssl rand -base64 32)
BETTER_AUTH_SECRET=replace-me-with-a-32-char-random-secret
# Public base URL of the API (used to build OAuth callback URLs).
BETTER_AUTH_URL=http://localhost:3000

# ── OAuth: Google (optional locally) ──────────────────────────────────────────
# Authorized redirect URI to register in Google Cloud Console:
#   {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── OAuth: Apple (optional locally) ───────────────────────────────────────────
# Services ID  = web OAuth client identifier
# Bundle ID    = native iOS client identifier
# Redirect URI to register: {BETTER_AUTH_URL}/api/auth/callback/apple
APPLE_SERVICES_ID=
APPLE_BUNDLE_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Contents of the .p8 private key (single line, \n escaped) — used to mint the client secret.
APPLE_PRIVATE_KEY=

# ── Client-side defaults (for reference; mobile/admin read their own .env) ────
# apps/mobile/.env:  EXPO_PUBLIC_API_URL=http://localhost:3000
# apps/admin/.env:   VITE_API_URL=http://localhost:3000
