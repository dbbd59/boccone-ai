{
  "name": "@boccone/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development bun --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun --sourcemap=linked",
    "start": "bun dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "food:download": "bun src/scripts/download-food-data.ts",
    "food:import": "bun src/scripts/import-food-data.ts"
  },
  "dependencies": {
    "@boccone/auth": "workspace:*",
    "@boccone/ai": "workspace:*",
    "@boccone/config": "workspace:*",
    "@boccone/contracts": "workspace:*",
    "@boccone/db": "workspace:*",
    "@boccone/utils": "workspace:*",
    "elysia": "^1.4.30",
    "@elysiajs/cors": "^1.4.1",
    "zod": "4.1.13"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "postgres": "^3.4.7"
  }
}
